# Skylark BI Agent - Environment Variables
# Copy this file to .env.local and fill in your values

# ─── Groq API ──────────────────────────────────────────────────────────────────
# Get from: https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# ─── Monday.com Integration ───────────────────────────────────────────────────
# Get from: Monday.com → Admin → API (bottom left avatar → Admin → API)
# Use a read-only token or personal API token.
MONDAY_API_TOKEN=eyJ...

# Board IDs: Open the board in Monday.com, look at the URL:
# https://yourcompany.monday.com/boards/1234567890
# The number at the end is your board ID.
MONDAY_WORK_ORDERS_BOARD_ID=1234567890
MONDAY_DEALS_BOARD_ID=0987654321

# ─── Optional: App Configuration ──────────────────────────────────────────────
# Set to 'true' to enable mock/demo data when Monday.com is not configured
# DEMO_MODE=false
